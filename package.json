{
  "name": "localhost-hub",
  "version": "0.9.0",
  "description": "Desktop control center for managing local development projects, scripts, and processes.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Christoffer Madsen",
    "email": "chris@madsens.dev"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "check:version": "node scripts/check-version-sync.cjs",
    "dev": "tauri dev",
    "dev:web": "vite",
    "generate:bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "generate:icons": "node scripts/generate-icons.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "release:notes": "node scripts/release-notes.cjs",
    "release:prep": "node scripts/prepare-release.cjs",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "keywords": [
    "tauri",
    "devtools",
    "vite",
    "react",
    "rust"
  ],
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "framer-motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^26.0.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.11",
    "toml": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.2",
    "vitest": "^2.1.5"
  }
}
