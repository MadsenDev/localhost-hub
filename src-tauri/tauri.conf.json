{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Localhost Hub",
  "version": "0.9.0-alpha.0",
  "identifier": "dev.madsens.localhost-hub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Localhost Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../buildResources/icon.png",
      "../buildResources/icon.icns",
      "../buildResources/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
